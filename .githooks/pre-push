#!/bin/sh
#
# Refuse to push a commit from a lineage that the public history does not
# contain.
#
# On 2026-09-24 this repository's history was rewritten with git-filter-repo to
# remove personal data at Stephen's instruction. The rewrite produced new commit
# hashes for the same work, so the pre-rewrite lineage still exists in local
# clones -- in this one as the branch `main-old-prescrub` -- and every commit on
# it carries the unscrubbed values in its tree. Pushing any of it would put that
# data back on a PUBLIC repository, and no amount of force-pushing afterwards
# takes it off GitHub's forks and caches reliably.
#
# The discriminator is exact rather than a name match: the old lineage shares NO
# MERGE BASE with the rewritten history, because filter-repo re-rooted it. Real
# new work always descends from the published history and always has one. So a
# missing merge base is the signal, and the branch name is only a hint in the
# message.
#
# A `git push --no-verify` still bypasses this, as it bypasses every hook. It is
# a guard against an accident, not against someone who means it.

remote="$1"
zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')

# The published history to measure against. Prefer the remote being pushed to.
published=""
for ref in "refs/remotes/$remote/main" "refs/remotes/origin/main"; do
    if git rev-parse --verify --quiet "$ref" >/dev/null; then
        published="$ref"
        break
    fi
done

if [ -z "$published" ]; then
    echo "pre-push: no $remote/main or origin/main to compare against." >&2
    echo "          Run 'git fetch $remote' so this hook can tell the rewritten" >&2
    echo "          history from the pre-scrub one, then push again." >&2
    exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # A deletion pushes nothing, so there is nothing to inspect.
    [ "$local_sha" = "$zero" ] && continue

    if [ -z "$(git merge-base "$local_sha" "$published" 2>/dev/null)" ]; then
        echo "" >&2
        echo "pre-push REFUSED: $local_ref shares no history with $published." >&2
        echo "" >&2
        echo "  That means it comes from the pre-rewrite lineage. Its commits" >&2
        echo "  carry the personal data the 2026-09-24 filter-repo scrub removed," >&2
        echo "  and this is a public repository." >&2
        if git rev-parse --verify --quiet main-old-prescrub >/dev/null \
           && git merge-base --is-ancestor "$local_sha" main-old-prescrub 2>/dev/null; then
            echo "  It is reachable from main-old-prescrub, which is kept locally" >&2
            echo "  for reference and is not meant to leave this machine." >&2
        fi
        echo "" >&2
        echo "  If you genuinely need this work on the remote, rebuild it on top" >&2
        echo "  of $published and re-scrub it. Do not force it through." >&2
        echo "" >&2
        status=1
    fi
done

exit $status
