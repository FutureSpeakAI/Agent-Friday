#!/bin/sh
# Agent Friday pre-commit hook — runs the secret/PII scanner before every commit.
#
# Activate (once, per clone):
#     git config core.hooksPath .githooks
#
# Bypass for a single line:  append  "# pragma: allowlist secret"
# Emergency bypass (discouraged):  git commit --no-verify
#
# Resolves a Python 3 interpreter across Windows (py launcher) and *nix.
set -e

HERE="$(dirname "$0")"
SCANNER="$HERE/security_scan.py"

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    echo "[pre-commit] no Python interpreter found; skipping security scan." >&2
    exit 0
fi

# ── Import smoke test ─────────────────────────────────────────────────────
# A module-level use-before-definition in services/agent.py cost a silent
# outage on 2026-08-19 (see docs/audits/server-death-forensics.md). Ruff
# cannot catch it - the names ARE defined, just too late - so only a real
# import proves statement order is sound. ~4s.
#
# Only runs when the repo venv exists: a bare clone without dependencies
# must not be blocked from committing by a missing-dependency false alarm.
if [ -x "$HERE/../venv/Scripts/python.exe" ]; then
    IMPORTPY="$HERE/../venv/Scripts/python.exe"
elif [ -x "$HERE/../venv/bin/python" ]; then
    IMPORTPY="$HERE/../venv/bin/python"
else
    IMPORTPY=""
fi

if [ -n "$IMPORTPY" ]; then
    if ! "$IMPORTPY" "$HERE/../scripts/check_imports.py"; then
        echo "[pre-commit] import smoke test FAILED - commit blocked." >&2
        echo "[pre-commit] emergency bypass (discouraged): git commit --no-verify" >&2
        exit 1
    fi
fi

# ── Gated-prompt caller check ─────────────────────────────────────────────
# 2026-08-25: 22 call sites built Friday's system prompt with no provider/
# vault_control decision, so TIER_2 vault content shipped to the cloud
# whenever the call routed there. The function's required arguments now make
# that a TypeError — but only a STATIC scan makes the failure loud at commit
# time; two of the twenty-two were background jobs that would otherwise not
# have been re-exercised (and so not have raised) until their own next
# scheduled run, hours or a day later. Pure AST parse, stdlib only — runs
# even without the venv, unlike the import smoke test above.
if ! $PY "$HERE/../scripts/check_gated_prompt_callers.py"; then
    echo "[pre-commit] gated-prompt caller check FAILED - commit blocked." >&2
    echo "[pre-commit] emergency bypass (discouraged): git commit --no-verify" >&2
    exit 1
fi

exec $PY "$SCANNER"
