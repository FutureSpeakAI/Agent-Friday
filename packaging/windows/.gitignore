# Build outputs and downloaded payloads. The repo describes how to build the
# installer; it does not store the ~11 MB Python distribution, the wheelhouse,
# or the finished zip.
dist/
staging/
payload/
wheelhouse/
*.zip

# PowerShell drops a module cache under whatever HOME the build ran with.
# build-installer.ps1 redirects the profile, so it lands here.
Microsoft/
