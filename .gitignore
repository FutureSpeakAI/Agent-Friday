# Agent Friday — ignore policy.
#
# This file answers one question: which classes of generated or private files
# never belong in the public tree. Patterns are grouped by class. Rationale for
# a class lives in SECURITY.md and docs/development/, not here.

# ── Local launch scripts and environment files (carry API keys) ──────────
*.bat
!scripts/install.bat
!packaging/windows/*.cmd
*.vbs
.env
*.env
.env.*

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# ── Node / Playwright tooling ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
*-install.log
test-results/
playwright-report/

# ── Build outputs ────────────────────────────────────────────────────────
dist/
build/
build_pyi/
*.manifest
*.log
# AgentFriday.spec is tracked on purpose: it is the PyInstaller recipe.

# ── Per-user runtime state (lives under ~/.friday; never in-repo) ────────
/settings.json
/config.yaml
secrets.json
credentials.json
.setup_complete
.friday-state.json
*.bandit.json
*.daily.json
*.state.json
data/*.json
appointments.json
insurance.json
wiki/
vault/
.friday/
creations/
self_improvement/
chroma/
chroma_db/
chromadb/
memory_db/
**/chroma/
*.chroma
*.sqlite3
test_tts*.wav
verify_tts.wav
*voice_debug*.log

# ── Credentials, tokens, keys — any location ─────────────────────────────
*.credentials*
*credentials*.json
google_token.json
google_accounts/
**/google_accounts/
token.json
*oauth*token*.json
**/bridge-token
**/node-identity.json
*.key
*.pem
*.pfx
.asimovs-mind/vault/bridge-token
.asimovs-mind/vault/port
asimovs-mind/

# ── AI-agent workspaces, private memory, local-only working notes ────────
.claude/
/memory/
.agents/
skills-lock.json
/AGENT_BEST_PRACTICES.md
/SCRUB_REPORT.md

# ── Generated art assets (built locally, not source) ─────────────────────
assets/palette/
assets/splash/

# ── Scenario-tier test artifacts (capture real conversations) ────────────
tests/app/scenarios/transcript.json
tests/app/scenarios/sent-messages.json
tests/screenshots/
tests/audit_screenshots/
tests/report.html
tests/last_run.log
tests/console_errors.log

# ── Editor / OS ──────────────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-*

# ── Root-level scratch: a leading underscore at the repo root means scratch ─
/_*
/openai
/Microsoft/
