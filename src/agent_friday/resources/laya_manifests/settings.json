 "not_for_laya": [
  {"action": "settings.connectors", "kind": "by_design", "reason": "Connectors, accounts and keys are owner-only."},
  {
   "action": "settings.local_voice_measure",
   "kind": "by_design",
   "reason": "Measure now runs the PC hard, so it is the owner's press in Settings > Voice; by voice, ask_friday queues it for when the owner is away."
  },
  {
   "action": "settings.local_voice_status",
   "kind": "by_design",
   "reason": "Not a router tool: local_voice_readiness is outside the full voice contract, and a test pins it out of the router. Voice asks it through ask_friday."
  },
  {
   "action": "settings.local_voice_switch_offer",
   "kind": "by_design",
   "reason": "The switch to local voice is the owner's yes on its own card, once; Laya never takes it."
  },
  {
   "action": "settings.interruptions",
   "kind": "by_design",
   "reason": "The interruption limit, quiet-hour times and Focus Assist are the owner's to loosen; by voice Laya can only quiet things (quiet until morning)."
  },
  {
   "action": "settings.laya_report",
   "kind": "by_design",
   "reason": "The report card shows the owner's own words and is served to the owner only; by voice, 'what have you learned?' is the laya_learning summary."
  },
  {
   "action": "settings.laya_item",
   "kind": "by_design",
   "reason": "Undo or forget of one learned item is the owner's control over their own data; Laya never runs it, and the voice 'forget that' needs the owner's own words."
  },
  {
   "action": "settings.laya_reset",
   "kind": "by_design",
   "reason": "Reset, roll back and wipe of what Laya learned are the owner's controls (voice: 'reset', 'go back to last week'); a wipe is a card only a screen click approves."
  },
  {
   "action": "settings.laya_confirm",
   "kind": "by_design",
   "reason": "Only the owner can confirm a choice the deeper mind made; Laya never confirms her own teacher (decision 3)."
  },
  {
   "action": "settings.laya_refit",
   "kind": "by_design",
   "reason": "Learn now starts a visible Local AI queue job the owner asked for; it also runs by itself when idle, on AC power, with the vault open."
  },
  {
   "action": "settings.laya_loosen",
   "kind": "by_design",
   "reason": "Loosening a learned threshold is the owner's decision, per head, by a click on the screen card (decision 15); Laya can never loosen herself."
  },
  {
   "action": "settings.laya_notice",
   "kind": "by_design",
   "reason": "Seeing the notice that Laya learns from corrections is the owner's own acknowledgement."
  }
 ],
 "notes": [
  {
   "id": "meeting_retention",
   "text": "Meeting retention (meeting_audio_retention, meeting_text_retention, meeting_text_retention_days) is the owner's own choice, set in Privacy & Data and the Meetings view; it is not a voice-settable key and has no verb."
  },
  {
   "id": "voice_live_trim",
   "text": "The Gemini Live options row 'Trim what each call carries' sets voice_live_trim (off, shadow, on). It is a settings-panel row, not one of the audited UI actions, so it has no verb here. Laya reaches it by voice through the call's own tools: 'use fewer tools' and 'give me everything' are in resources/voice_session_phrasings.json (more_tools, internal gate, ring 1). Changing the mode itself stays the owner's choice in the panel.",
   "verbs": ["voice_session.fewer_tools", "voice_session.everything"]
  }
 ],
